# ============================================
# Agent Platform 生产环境配置（服务器专用）
# 复用服务器上已有 Docker MySQL 容器，不启动新 MySQL
# 由 one-click-deploy.sh 复制为 .env，不影响本地 .env
# ============================================

HOST=0.0.0.0
PORT=8000
DEBUG=false
DEPLOY_PORT=8082

# --- 已有 Docker MySQL（由 deploy 脚本自动探测容器名与网络）---
# 若自动探测不准，可手动指定：
# MYSQL_CONTAINER=你的mysql容器名
# MYSQL_DOCKER_NETWORK=mysql所在docker网络名
# MYSQL_HOST=与 MYSQL_CONTAINER 相同（容器名）
MYSQL_CONTAINER=
MYSQL_DOCKER_NETWORK=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=whq050207
MYSQL_DATABASE=agent_platform
DATABASE_URL=

# --- LLM（必填至少一个 Provider）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEFAULT_LLM_PROVIDER=deepseek

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

CUSTOM_API_KEY=not-needed
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# --- 容器内服务（仅 Docker 网络内访问，不映射宿主机端口）---
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=./data/chroma

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=prod_neo4j_password_change_me
NEO4J_DATABASE=neo4j

REDIS_URL=redis://redis:6379/0

# --- 认证 ---
AUTH_ENABLED=true
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_TTL_SECONDS=86400

# --- 记忆 / Agent ---
SHORT_TERM_MEMORY_MAX_TOKENS=4000
LONG_TERM_MEMORY_TOP_K=5
EPISODIC_MEMORY_MAX_EVENTS=20
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=120
DEBATE_MAX_ROUNDS=3
