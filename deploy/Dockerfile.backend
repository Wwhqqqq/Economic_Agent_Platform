FROM python:3.11-slim

WORKDIR /app

# pymysql / aiomysql are pure Python — no gcc or libmysqlclient-dev needed.
# Override mirror at build time if needed:
#   docker compose build --build-arg PIP_INDEX_URL=https://pypi.org/simple backend

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_PREFER_BINARY=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST} \
    PIP_DEFAULT_TIMEOUT=300

COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --upgrade pip setuptools wheel \
    && pip install --retries 10 --timeout 300 -r /app/backend/requirements.txt

COPY backend /app/backend
COPY data/member_knowledge /app/data/member_knowledge

WORKDIR /app/backend

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
