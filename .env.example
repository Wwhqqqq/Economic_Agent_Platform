# ============================================
# Agent Platform 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================

# --- 服务器配置 ---
HOST=0.0.0.0
PORT=8000
DEBUG=true

# --- DeepSeek 配置（默认模型接入）---
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEFAULT_LLM_PROVIDER=deepseek

# --- OpenAI 兼容配置 ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- Anthropic 配置 ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- 本地/自定义模型配置 ---
CUSTOM_API_KEY=not-needed
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_MODEL=qwen2.5:7b

# --- ChromaDB 配置 ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./data/chroma

# --- Neo4j 配置 ---
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=Whq050207
NEO4J_DATABASE=neo4j

# --- 记忆系统配置 ---
SHORT_TERM_MEMORY_MAX_TOKENS=4000
LONG_TERM_MEMORY_TOP_K=5
EPISODIC_MEMORY_MAX_EVENTS=20

# --- 代理配置 ---
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=120
DEBATE_MAX_ROUNDS=3

# --- 可选认证（AUTH_ENABLED=true 时启用）---
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123
JWT_SECRET=agent-platform-dev-secret-change-me
